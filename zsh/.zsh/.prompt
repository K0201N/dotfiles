for _zc in "${HOMEBREW_PREFIX:-}/share/zsh-completions" \
           /opt/homebrew/share/zsh-completions \
           /usr/local/share/zsh-completions; do
  if [ -d "$_zc" ]; then
    fpath=("$_zc" $fpath)
    break
  fi
done
unset _zc

autoload -Uz compinit
compinit -u

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
autoload colors
zstyle ':completion:*' list-colors ''

autoload -Uz vcs_info
zstyle ':vcs_info:git:*' check-for-changes true
zstyle ':vcs_info:git:*' stagedstr "%F{#FF00FF}!"
zstyle ':vcs_info:git:*' unstagedstr "%F{#FFFF00}+"
zstyle ':vcs_info:*' formats "%F{#00FF00} 🌿%c%u%b%f"
zstyle ':vcs_info:*' actionformats '[%b|%a]'

precmd () { vcs_info }

PROMPT='
🦄%B%F{#9400D3}%n@%m%f%b 🏠%F{#00FFFF}%~%f%F{#00FF00}$vcs_info_msg_0_%f
%F{#FFFF00}$%f '
