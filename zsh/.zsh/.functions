# fzf
export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git"'
export FZF_DEFAULT_OPTS='--height 40% --reverse --border'
export FZF_CTRL_T_COMMAND='rg --files --hidden --follow --glob "!.git/*"'
export FZF_CTRL_T_OPTS='--preview "bat  --color=always --style=header,grid --line-range :100 {}"'
[ -f "$(brew --prefix)/opt/fzf/shell/key-bindings.zsh" ] && source "$(brew --prefix)/opt/fzf/shell/key-bindings.zsh"
[ -f "$(brew --prefix)/opt/fzf/shell/completion.zsh" ] && source "$(brew --prefix)/opt/fzf/shell/completion.zsh"

fvim() {
  local files selected_files
  files=$(git ls-files) &&
  selected_files=$(echo "$files" | fzf -m --preview 'head -100 {}') &&
  vim -- ${(f)selected_files}
}

fga() {
  local files selected
  (
    cd "$(git rev-parse --show-toplevel)" || return 1
    files=$(git -c core.quotePath=false status --porcelain) || return 1
    if printf '%s\n' "$files" | grep -q '\\'; then
      echo "特殊文字を含むファイル名があるため fga では扱えません。git add を直接使ってください" >&2
      return 1
    fi
    files=$(printf '%s\n' "$files" | sed -E -e 's/^[RC].{2}.* -> //' -e 't q' -e 's/^.{3}//' -e ':q' -e 's/^"(.*)"$/\1/') &&
    selected=$(printf '%s\n' "$files" | fzf -m --preview 'git diff -- {}') &&
    git add -- ${(f)selected}
  )
}

fbr() {
  local branches branch
  branches=$(git --no-pager branch -vv) &&
  branch=$(echo "$branches" | fzf +m) &&
  git checkout "$(echo "$branch" | sed 's/^[*+] *//' | awk '{print $1}')"
}

flog() {
  git log --graph --color=always \
      --format="%C(auto)%h%d %s %C(black)%C(bold)%cr" "$@" |
  fzf --ansi --no-sort --reverse --tiebreak=index --bind=ctrl-s:toggle-sort \
      --bind "ctrl-m:execute:
                (grep -o '[a-f0-9]\{7\}' | head -1 |
                xargs -I % sh -c 'git show --color=always % | less -R') << 'FZF-EOF'
                {}
                FZF-EOF"
}

fcd() {
  local dir
  dir=$(find ${1:-.} -path '*/\.*' -prune \
                  -o -type d -print 2> /dev/null | fzf +m) &&
  cd "$dir"
}

brew-maintenance() {
  echo "Starting Homebrew maintenance..."
  brew update
  HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1 brew upgrade
  brew autoremove
  brew cleanup
  echo "Done!"
}

_ec2_id_by_name() {
  local out
  local -a ids
  if [ -z "$1" ]; then
    echo "インスタンス名を指定してください" >&2
    return 1
  fi
  out="$(aws ec2 describe-instances \
    --filters "Name=tag:Name,Values=$1" \
              "Name=instance-state-name,Values=pending,running,stopping,stopped" \
    --query 'Reservations[].Instances[].InstanceId' \
    --output text)" || return 1
  ids=(${=out})
  case ${#ids} in
    0) echo "指定したインスタンスが見つかりません: $1" >&2; return 1 ;;
    1) print -r -- "${ids[1]}" ;;
    *) echo "インスタンス名が複数に一致します: $1 (${ids[*]})" >&2; return 1 ;;
  esac
}

_ec2_state() {
  aws ec2 describe-instances --instance-ids "$1" \
    --query 'Reservations[0].Instances[0].State.Name' --output text
}

_ec2_ensure_running() {
  local id="$1" name="$2" state
  state="$(_ec2_state "$id")" || return 1
  case "$state" in
    running)
      echo "すでに起動しています: $name ($id)"
      return 0
      ;;
    pending)
      echo "起動中 → $name ($id)"
      ;;
    stopped)
      echo "起動中: $name ($id)"
      aws ec2 start-instances --instance-ids "$id" >/dev/null || return 1
      ;;
    *)
      echo "起動できない状態です: $name ($id) [$state]" >&2
      return 1
      ;;
  esac
  echo "起動完了を待機中..."
  aws ec2 wait instance-running --instance-ids "$id" || return 1
  echo "起動しました: $name"
}

_ec2_connect() {
  local dns
  dns="$(aws ec2 describe-instances --instance-ids "$1" \
    --query 'Reservations[0].Instances[0].NetworkInterfaces[0].Association.PublicDnsName' \
    --output text)" || return 1

  if [ -z "$dns" ] || [ "$dns" = "None" ]; then
    echo "Public DNS が取得できません（Elastic IP/パブリックIPなしの可能性）" >&2
    return 1
  fi

  echo "SSH接続中: ec2-user@$dns"
  ssh "ec2-user@$dns"
}

ec2list() {
  aws ec2 describe-instances \
    --query 'Reservations[].Instances[].[
      Tags[?Key==`Name`]|[0].Value,
      InstanceId,
      State.Name
    ]' \
    --output table
}

ec2ls() {
  local name_filter
  name_filter="${1:-*}"
  aws ec2 describe-instances \
    --filters "Name=tag:Name,Values=*${name_filter}*" \
    --query 'Reservations[].Instances[].[
      Tags[?Key==`Name`]|[0].Value,
      InstanceId,
      InstanceType,
      State.Name,
      PublicIpAddress,
      PrivateIpAddress,
      Placement.AvailabilityZone
    ]' \
    --output table
}

ec2-ssh() {
  local id
  id="$(_ec2_id_by_name "$1")" || return 1
  _ec2_connect "$id"
}

ec2-start() {
  local id
  id="$(_ec2_id_by_name "$1")" || return 1
  _ec2_ensure_running "$id" "$1"
}

ec2-start-ssh() {
  local id
  id="$(_ec2_id_by_name "$1")" || return 1
  _ec2_ensure_running "$id" "$1" || return 1
  _ec2_connect "$id"
}

ec2-stop() {
  local id state
  id="$(_ec2_id_by_name "$1")" || return 1
  state="$(_ec2_state "$id")" || return 1

  if [ "$state" = "stopped" ]; then
    echo "すでに停止しています: $1 ($id)"
    return 0
  fi

  echo "停止中: $1 ($id)"
  aws ec2 stop-instances --instance-ids "$id" >/dev/null || return 1
  echo "停止完了を待機中..."
  aws ec2 wait instance-stopped --instance-ids "$id" || return 1
  echo "停止しました: $1"
}

# 指定ディレクトリを GitHub リポジトリ化して push まで行う
gh-init-push() {
  local target_dir repo_name visibility branch default_branch

  if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    echo "usage: gh-init-push [directory] [repo_name|public|private|internal] [public|private|internal]"
    echo "defaults: directory=. repo_name=current directory visibility=private"
    echo "example: gh-init-push ~/src/my-app"
    echo "example: gh-init-push ~/src/my-app public"
    echo "example: gh-init-push ~/src/my-app k/my-app private"
    return 0
  fi

  if ! command -v git >/dev/null 2>&1; then
    echo "git が見つかりません" >&2
    return 1
  fi

  if ! command -v gh >/dev/null 2>&1; then
    echo "gh が見つかりません" >&2
    return 1
  fi

  target_dir="${1:-.}"
  repo_name="${2:-}"
  visibility="${3:-}"
  default_branch="main"

  if [ -z "$visibility" ]; then
    case "$repo_name" in
      public|private|internal)
        visibility="$repo_name"
        repo_name=""
        ;;
    esac
  fi

  visibility="${visibility:-private}"

  case "$visibility" in
    public|private|internal)
      ;;
    *)
      echo "visibility は public / private / internal を指定してください" >&2
      return 1
      ;;
  esac

  if [ ! -d "$target_dir" ]; then
    echo "ディレクトリが見つかりません: $target_dir" >&2
    return 1
  fi

  (
    cd "$target_dir" || return 1

    if [ ! -e .git ]; then
      if ! git init -b "$default_branch" >/dev/null 2>&1; then
        git init || return 1
        git symbolic-ref HEAD "refs/heads/$default_branch" || return 1
      fi
    fi

    branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)"
    if [ -z "$branch" ]; then
      echo "現在の HEAD がブランチを指していません" >&2
      return 1
    fi

    if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
      if [ "$branch" = "master" ]; then
        git branch -m "$default_branch" || return 1
        branch="$default_branch"
      fi

      git add -A || return 1

      if git diff --cached --quiet; then
        git commit --allow-empty -m "Initial commit" || return 1
      else
        git commit -m "Initial commit" || return 1
      fi
    fi

    if git remote get-url origin >/dev/null 2>&1; then
      git push -u origin "$branch" || return 1
      return 0
    fi

    if [ -z "$repo_name" ]; then
      repo_name="$(basename "$PWD")"
    fi

    gh repo create "$repo_name" --"$visibility" --source=. --remote=origin --push || return 1
  )
}
